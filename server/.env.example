# You don't need all four — just set a key for whichever provider(s)
# you'll pick from the dropdown in the app. Leave the rest blank.

# Gemini — genuinely free tier, no credit card. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek — low-cost, requires a funded account. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Claude (Anthropic) — requires a funded account. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ChatGPT (OpenAI) — requires a funded account. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=8787
